# Required: the email address used in SMTP MAIL FROM during verification.
# Use a real domain you own — some strict mail servers reject localhost.local.
VERIFY_FROM_ADDR=ebukaamadiobi@gmail.com

# Optional: max concurrent SMTP connections (default: 10)
MAX_CONCURRENT=10

# Optional: max concurrent SMTP connections per domain (default: 2)
MAX_CONCURRENT_PER_DOMAIN=2

# Optional: max rows accepted per batch upload (default: 1000)
MAX_BATCH_SIZE=1000
